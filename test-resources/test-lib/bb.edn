{:paths ["."]
 :deps {io.github.clojure/tools.build {:mvn/version "0.10.14"}
        io.github.babashka/deps-deploy {:local/root "../.."}}
 :tasks
 {deploy {:doc "Build and deploy to Clojars: bb deploy 0.0.1 [sources] [sign]"
          :requires ([build])
          :task (let [[version & flags] *command-line-args*
                      flags (set flags)]
                  (build/deploy {:version version
                                 :sources (contains? flags "sources")
                                 :sign (contains? flags "sign")}))}
  deploy-built {:doc "Deploy a jar already built under target, without tools.build: bb deploy-built 0.0.0-SNAPSHOT [sources]"
                :task (let [[version & flags] *command-line-args*
                            jar (fn [suffix] (str "target/deps-deploy-test-lib-" version suffix ".jar"))]
                        (run! println
                              ((requiring-resolve 'babashka.deps-deploy/deploy)
                               {:artifact (cond-> [(jar "")] (contains? (set flags) "sources") (conj (jar "-sources")))
                                :pom-file "target/classes/META-INF/maven/io.github.babashka/deps-deploy-test-lib/pom.xml"})))}}}
